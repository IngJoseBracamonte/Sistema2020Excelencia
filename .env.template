# ═══════════════════════════════════════════════════════════
# Variables de Entorno — Sistema Sat Hospitalario Docker
# ═══════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env:    copy .env.template .env
# 2. Editar los valores según tu entorno
# 3. NUNCA commitear el archivo .env (ya está en .gitignore)
#
# El instalador (install.ps1) genera este archivo automáticamente.
# ═══════════════════════════════════════════════════════════

# --- Dominio Local ---
DOMAIN_NAME=hospital.local
HOST_PORT=80

# --- MySQL (Instalado en Windows, NO en Docker) ---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
MYSQL_SYSTEM_DB=SatHospitalario
MYSQL_IDENTITY_DB=SatHospitalarioIdentity
MYSQL_LEGACY_DB=sistema2020

# --- JWT (Seguridad) ---
# IMPORTANTE: Use una clave aleatoria de al menos 32 caracteres.
JWT_SECRET=REPLACE_WITH_A_RANDOM_JWT_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=SistemaSatHospitalarioAPI
JWT_AUDIENCE=SistemaSatHospitalario_PWA

# --- SMTP (Opcional — Dejar vacío si no se usa) ---
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# --- Playwright (Reporte de fallos E2E) ---
PLAYWRIGHT_API_URL=REPLACE_WITH_THE_TICKET_REPORT_ENDPOINT
PLAYWRIGHT_TESTING_TOKEN=REPLACE_WITH_A_SECURE_TESTING_TOKEN

# --- WATCHTOWER AUTO-UPDATES CONTROL (DESARROLLO VS PRODUCCION) ---
# true: Solo monitorea e informa, NO descarga ni actualiza (Desarrollo Local)
# false: Descarga de GitHub y actualiza automáticamente (Producción)
WATCHTOWER_MONITOR_ONLY=false

